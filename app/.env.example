NODE_ENV=development
HOST=127.0.0.1
PORT=3100
DATABASE_URL=postgresql://crypto_agent:replace-with-a-long-random-password@localhost:5433/crypto_agent
# Read previous posts, active series and thesis for writing context.
# false skips these reads only; PostgreSQL is still required for snapshots/drafts/review.
DB_CONTEXT_ENABLED=true
# Required, at least 24 characters. n8n and review page use X-API-Key.
INTERNAL_API_KEY=replace-with-at-least-24-random-characters
BINANCE_BASE_URL=https://api.binance.com
BINANCE_FUTURES_URL=https://fapi.binance.com
ENABLE_FUTURES=true
# Temporary data-only draft mode; set true to restore AI writing.
AI_WRITER_ENABLED=false
# A provider supporting POST /chat/completions and JSON response_format.
# AI_BASE_URL must include the provider's API version path, if required.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Ordered fallbacks on the same provider/key, maximum 4. Blank disables fallback.
# Gemini free-tier example: gemini-3.1-flash-lite,gemini-2.5-flash-lite
AI_FALLBACK_MODELS=
AI_TIMEOUT_MS=60000
MIN_TREND_SCORE=75
MIN_QUOTE_VOLUME=10000000
SCANNER_SHORTLIST=20
# Prefer another token until this many hours have passed. If every candidate is
# still cooling down, choose the least recently selected token instead.
TRENDING_SYMBOL_COOLDOWN_HOURS=12
# If writing/charting the preferred token fails, try the next diverse candidate.
TRENDING_MAX_CANDIDATE_ATTEMPTS=3
SNAPSHOT_MAX_AGE_MINUTES=15
OUTPUT_DIR=output
PUPPETEER_EXECUTABLE_PATH=
# Keep Chromium sandbox enabled. Configure the host if Chromium cannot launch.
