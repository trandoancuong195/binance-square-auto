{
  "name": "Crypto Square - Draft every 30 minutes",
  "active": false,
  "settings": { "executionOrder": "v1", "timezone": "Asia/Bangkok" },
  "nodes": [
    {
      "id": "schedule", "name": "Every 30 minutes", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2,
      "position": [0, 0], "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 30 }] } }
    },
    {
      "id": "start", "name": "Start pipeline", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
      "position": [240, 0], "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST", "url": "http://127.0.0.1:3100/pipeline/run",
        "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth",
        "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ requestKey: 'n8n-' + $execution.id }) }}",
        "options": { "timeout": 30000 }
      }
    },
    {
      "id": "wait", "name": "Wait 30 seconds", "type": "n8n-nodes-base.wait", "typeVersion": 1.1,
      "position": [480, 0], "parameters": { "resume": "timeInterval", "amount": 30, "unit": "seconds" }, "webhookId": "crypto-square-poll"
    },
    {
      "id": "poll", "name": "Read run", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
      "position": [720, 0], "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 5000,
      "parameters": {
        "url": "={{ 'http://127.0.0.1:3100/pipeline/runs/' + $('Start pipeline').first().json.id }}",
        "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "options": { "timeout": 30000 }
      }
    },
    {
      "id": "running", "name": "Still running within deadline", "type": "n8n-nodes-base.if", "typeVersion": 2.2,
      "position": [960, 0], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }, "conditions": [{ "id": "is-running", "leftValue": "={{ $json.status === 'RUNNING' && Date.now() - Date.parse($json.created_at) < 1800000 }}", "rightValue": "", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }], "combinator": "and" }, "options": {} }
    },
    {
      "id": "success", "name": "Succeeded", "type": "n8n-nodes-base.if", "typeVersion": 2.2,
      "position": [1200, 140], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }, "conditions": [{ "id": "is-success", "leftValue": "={{ $json.status }}", "rightValue": "SUCCEEDED", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "options": {} }
    },
    {
      "id": "failed", "name": "Report failure", "type": "n8n-nodes-base.stopAndError", "typeVersion": 1,
      "position": [1440, 260], "parameters": { "errorType": "errorMessage", "errorMessage": "={{ 'Crypto Square run failed or polling timed out: ' + JSON.stringify($json) }}" }
    }
  ],
  "connections": {
    "Every 30 minutes": { "main": [[{ "node": "Start pipeline", "type": "main", "index": 0 }]] },
    "Start pipeline": { "main": [[{ "node": "Wait 30 seconds", "type": "main", "index": 0 }]] },
    "Wait 30 seconds": { "main": [[{ "node": "Read run", "type": "main", "index": 0 }]] },
    "Read run": { "main": [[{ "node": "Still running within deadline", "type": "main", "index": 0 }]] },
    "Still running within deadline": { "main": [[{ "node": "Wait 30 seconds", "type": "main", "index": 0 }], [{ "node": "Succeeded", "type": "main", "index": 0 }]] },
    "Succeeded": { "main": [[], [{ "node": "Report failure", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "tags": []
}
